# Public site URL (used for canonical URLs, sitemap, and email links)
NEXT_PUBLIC_SITE_URL=https://www.pamarenterprises.com

# Email delivery (https://resend.com). Without RESEND_API_KEY, development logs emails
# to the console and production form submissions fail with a visible error.
RESEND_API_KEY=
EMAIL_FROM="Pamar Enterprises <no-reply@pamarenterprises.com>"

# Notification inboxes (each falls back to the main site email)
CONTACT_TO_EMAIL=

# Cloudflare Turnstile spam protection (optional; honeypot is always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
